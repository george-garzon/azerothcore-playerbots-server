COMPOSE_PROJECT_NAME=azerothcore-playerbots

# Experience multipliers (Dungeon Finder quests use their own rate).
XP_RATE_KILL=3
XP_RATE_QUEST=3
XP_RATE_QUEST_DF=3

# The setup scripts clone the latest compatible Playerbot fork here.
ACORE_DIR=./azerothcore-wotlk
ACORE_BRANCH=Playerbot

# Docker / database
DOCKER_IMAGE_TAG=playerbot-local
DOCKER_DB_ROOT_PASSWORD=change-me
DOCKER_DB_EXTERNAL_PORT=63306
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878
DASHBOARD_EXTERNAL_PORT=3000

# Comma-separated username:password pairs created after the auth DB import.
# Existing accounts are left untouched on later starts.
INITIAL_ACCOUNTS=george:password,harper:password,colby:password,isaac:password

# 500 random playerbots, autologged to populate the world.
BOT_MIN=500
BOT_MAX=500
BOT_ACCOUNT_COUNT=0
ADDCLASS_ACCOUNT_POOL_SIZE=50
RANDOM_BOT_MIN_LEVEL=1
RANDOM_BOT_MAX_LEVEL=80

# Solo LFG / dungeon-friendly bot behavior.
MAX_ADDED_BOTS=40
GROUP_INVITATION_PERMISSION=2
APPLY_INSTANCE_STRATEGIES=1
SUMMON_WHEN_GROUP=1
AUTO_AVOID_AOE=1
AUTO_PARTY_BUFFS=2
SYNC_QUEST_WITH_PLAYER=1
RANDOM_BOT_JOIN_LFG=1

# Battleground bots. Auto-join creates bot-filled BGs without waiting on players.
RANDOM_BOT_JOIN_BG=1
RANDOM_BOT_AUTO_JOIN_BG=1
RANDOM_BOT_BG_WS_BRACKETS=7
RANDOM_BOT_BG_AB_BRACKETS=6
RANDOM_BOT_BG_AV_BRACKETS=3
RANDOM_BOT_BG_EY_BRACKETS=2
RANDOM_BOT_BG_IC_BRACKETS=1
RANDOM_BOT_BG_WS_COUNT=1
RANDOM_BOT_BG_AB_COUNT=1
RANDOM_BOT_BG_AV_COUNT=0
RANDOM_BOT_BG_EY_COUNT=1
RANDOM_BOT_BG_IC_COUNT=0

# Dungeon-clear module defaults. A bot tank drives `.dc on` dungeon runs.
DUNGEON_CLEAR_ENABLE=1
DUNGEON_CLEAR_BETTER_LOOT_ROLLING=1
DUNGEON_CLEAR_LOOT_MIN_QUALITY=1
DUNGEON_CLEAR_REST_HEALTH_PCT=85
DUNGEON_CLEAR_REST_MANA_PCT=75

# AutoBalance defaults for solo/small-group dungeon and raid scaling.
AUTOBALANCE_ENABLE=1
AUTOBALANCE_MIN_PLAYERS=1
AUTOBALANCE_MIN_PLAYERS_HEROIC=1
AUTOBALANCE_MIN_PLAYERS_RAID=1
AUTOBALANCE_MIN_PLAYERS_RAID_HEROIC=1

# AoE loot quality-of-life.
AOE_LOOT_ENABLE=1
AOE_LOOT_RANGE=55.0
AOE_LOOT_GROUP=1

# Respawn dead players at the dungeon entrance for smoother solo dungeon runs.
DUNGEON_RESPAWN_ENABLE=1
DUNGEON_RESPAWN_HEALTH_PCT=50.0

# NPC that teaches mounts.
ALL_MOUNTS_NPC_ANNOUNCE=1
ALL_MOUNTS_NPC_ENABLE_AI=1
ALL_MOUNTS_NPC_TEACH_BENGAL_TIGER=0

# Money-for-kills. PvE/boss rewards are on; PvP gold stealing is off for friend safety.
MFK_ENABLE=1
MFK_ANNOUNCE=0
MFK_ANNOUNCE_WORLD_BOSS=1
MFK_ANNOUNCE_WORLD_PVP=0
MFK_ANNOUNCE_GROUP_DUNGEON_BOSS=0
MFK_BOUNTY_KILLING_BLOW_ONLY=0
MFK_BOUNTY_MONEY_FOR_NOTHING=0
MFK_PVP_CORPSE_LOOT_PERCENT=0
MFK_BOUNTY_KILL_MULTIPLIER=10
MFK_PVP_KILL_MULTIPLIER=0
MFK_BOUNTY_DUNGEON_BOSS_MULTIPLIER=25
MFK_BOUNTY_WORLD_BOSS_MULTIPLIER=20
MFK_KILLER_LEVEL_DIFF_ENABLE=1
MFK_MAX_GOLD_THRESHOLD=0.5

# mod-ah-bot-plus needs one or more real character GUIDs after first start.
# Leave this as 0 until you create the AH bot character.
AHBOT_GUIDS=0
AHBOT_ENABLE_SELLER=1
AHBOT_ENABLE_BUYER=1
AHBOT_ITEMS_PER_CYCLE=400
AHBOT_ALLIANCE_MIN_ITEMS=25000
AHBOT_ALLIANCE_MAX_ITEMS=25000
AHBOT_HORDE_MIN_ITEMS=25000
AHBOT_HORDE_MAX_ITEMS=25000
AHBOT_NEUTRAL_MIN_ITEMS=10000
AHBOT_NEUTRAL_MAX_ITEMS=10000
AHBOT_BUY_CANDIDATES_PER_CYCLE=10
AHBOT_ACCEPTABLE_PRICE_MODIFIER=1

# Native Windows Ollama with AMD Vulkan GPU support; see docs/ollama.md.
OLLAMA_CHAT_ENABLE=1
OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/generate
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_CHAT_RATE_LIMIT_GLOBAL_PER_MINUTE=20

OLLAMA_CHAT_DISABLE_IN_COMBAT=0
OLLAMA_CHAT_RANDOM_CHATTER=1
